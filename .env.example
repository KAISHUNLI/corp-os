# corp-os local settings
CORP_OS_ENV=dev
CORP_OS_DATABASE_URL=sqlite:///./data/corp_os.db
CORP_OS_UPLOAD_DIR=./data/uploads
CORP_OS_SECRET_KEY=change-me-in-production
CORP_OS_ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORP_OS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Baseline login (no IM required)
CORP_OS_AUTH_ACCOUNT_ENABLED=true
CORP_OS_DEMO_PASSWORD=demo123

# Optional: DingTalk
CORP_OS_DINGTALK_ENABLED=false
CORP_OS_DINGTALK_APP_KEY=
CORP_OS_DINGTALK_APP_SECRET=
CORP_OS_DINGTALK_REDIRECT_URI=http://127.0.0.1:5173/login
CORP_OS_DINGTALK_MOCK_ENABLED=true

# Optional: WeCom / Feishu
CORP_OS_WECOM_ENABLED=false
CORP_OS_FEISHU_ENABLED=false
