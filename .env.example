# corp-os local settings
CORP_OS_ENV=dev
CORP_OS_DATABASE_URL=postgresql+psycopg://corpos:corpos_dev_password@127.0.0.1:5432/corp_os
CORP_OS_UPLOAD_DIR=./data/uploads
CORP_OS_SECRET_KEY=change-me-in-production
CORP_OS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CORP_OS_DEMO_PASSWORD=demo123
CORP_OS_REDIS_URL=redis://127.0.0.1:6379/0
# CORP_OS_REDIS_ENABLED=true
# CORP_OS_ERP_TOKEN_TTL_SECONDS=3600
CORP_OS_MILVUS_URI=http://127.0.0.1:19530
CORP_OS_MILVUS_COLLECTION=corp_os_chunks
CORP_OS_VECTOR_STORE=milvus

# Embedding（第3步）
CORP_OS_EMBEDDING_PROVIDER=sentence_transformers
CORP_OS_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
CORP_OS_EMBEDDING_VECTOR_DIM=512
CORP_OS_EMBEDDING_QUERY_PREFIX=为这个句子生成表示以用于检索：
CORP_OS_EMBEDDING_MIN_SCORE=0.25
# 国内下载模型：export HF_ENDPOINT=https://hf-mirror.com

# Chat LLM（第5步）默认 off=模板回答；配密钥后改为 openai_compatible
CORP_OS_LLM_PROVIDER=off
# CORP_OS_LLM_PROVIDER=openai_compatible
# CORP_OS_LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# CORP_OS_LLM_API_KEY=sk-xxx
# CORP_OS_LLM_MODEL=qwen-plus
# CORP_OS_LLM_TEMPERATURE=0.2
# 会话短期记忆：注入 LLM 的最近 user/assistant 条数（0=关闭）
# CORP_OS_CHAT_HISTORY_MAX_MESSAGES=16

# 意图分类：LLM 开启后先判意图，仅 knowledge 走 RAG
# CORP_OS_INTENT_LLM_MODE=auto
# CORP_OS_INTENT_MIN_CONFIDENCE=0.35

# Agent：auto=意图优先；agent=强制 tool-calling；rules=强制关键词
# CORP_OS_AGENT_MODE=auto
# CORP_OS_AGENT_MAX_STEPS=6

# company-er（第7步）
CORP_OS_ERP_ENABLED=false
CORP_OS_ERP_BASE_URL=http://127.0.0.1:8002
# 也可指向前端反代：http://127.0.0.1:8080（同源 /api/v1）
# CORP_OS_ERP_OPENAPI_URL=http://127.0.0.1:8002/openapi.json
CORP_OS_ERP_USERNAME=admin
CORP_OS_ERP_PASSWORD=admin
# CORP_OS_ERP_CALL_LIST_LIMIT=15
# CORP_OS_ERP_CALL_MAX_CHARS=6000

# 身份与安全（第9步）
# CORP_OS_ERP_IDENTITY_MODE=hybrid
# CORP_OS_ERP_CREDENTIAL_MAP={"admin":"admin"}
# CORP_OS_LOGIN_RATE_LIMIT_PER_MINUTE=20
# CORP_OS_MAX_UPLOAD_BYTES=20971520
# CORP_OS_SSO_DINGTALK_ENABLED=false
# CORP_OS_SSO_OIDC_ENABLED=false
