# ===== 基础设施（compose 服务用）=====
POSTGRES_USER=corpos
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=corp_os
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091

# 对外端口：前端 8081（避免与 company-er 的 8080 冲突）；API 可选直连
WEB_PORT=8081
API_PORT=8001

# ===== 应用（api 容器，前缀必须是 CORP_OS_）=====
CORP_OS_ENV=production
CORP_OS_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
CORP_OS_DEMO_PASSWORD=demo123
# 改成你的访问地址，例如 http://你的公网IP:8081
CORP_OS_CORS_ORIGINS=http://127.0.0.1:8081,http://localhost:8081

CORP_OS_VECTOR_STORE=milvus
CORP_OS_MILVUS_COLLECTION=corp_os_chunks
CORP_OS_REDIS_ENABLED=true

# Embedding（国内建议保留镜像）
CORP_OS_EMBEDDING_PROVIDER=sentence_transformers
CORP_OS_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
CORP_OS_EMBEDDING_VECTOR_DIM=512
CORP_OS_HF_ENDPOINT=https://hf-mirror.com

# Chat LLM（默认 off；上线对话质量需要配密钥）
CORP_OS_LLM_PROVIDER=off
# CORP_OS_LLM_PROVIDER=openai_compatible
# CORP_OS_LLM_API_BASE=https://api.deepseek.com/v1
# CORP_OS_LLM_API_KEY=sk-xxx
# CORP_OS_LLM_MODEL=deepseek-chat

# 同机已部署 company-er 时可用 host.docker.internal
CORP_OS_ERP_ENABLED=false
CORP_OS_ERP_BASE_URL=http://host.docker.internal:8080
CORP_OS_ERP_USERNAME=admin
CORP_OS_ERP_PASSWORD=admin
